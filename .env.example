# Copy to `.env` and fill in. The `.env` file is gitignored.
# The core pipeline (data access + RLS + guardrails + evals) runs fully offline.

# --- Server auth ---
# `dev` mode: caller identity is taken from GOVERNED_DEV_CALLER (JSON claims) or the
#            `--caller` CLI flag — no token required. For local development only.
# `token` mode: caller identity is extracted from a bearer token on the
#            `Authorization` header (JWT or an Entra ID access token in production).
GOVERNED_AUTH_MODE=dev
GOVERNED_DEV_CALLER={"sub":"dev","roles":["admin"]}

# --- Optional: JWT verification (token mode) ---
# GOVERNED_JWT_ISSUER=
# GOVERNED_JWT_AUDIENCE=
